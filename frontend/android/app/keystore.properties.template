# Template for Android release signing — copy to `keystore.properties` in this
# same directory (frontend/android/app/) and fill in real values. The real
# file is gitignored and MUST NEVER be committed.
#
# How to generate the keystore (one-time, locally):
#
#   keytool -genkey -v \
#     -keystore hi-again-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias hi-again
#
#   - Set a strong password (you'll need it for every future update).
#   - Save the .jks file AND the passwords in your password manager. If you
#     lose them you can NEVER update the app on Play Store again — you'd
#     have to publish under a new package name from scratch.
#
# Then fill in this file:

storeFile=/absolute/path/to/hi-again-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=hi-again
keyPassword=YOUR_KEY_PASSWORD
